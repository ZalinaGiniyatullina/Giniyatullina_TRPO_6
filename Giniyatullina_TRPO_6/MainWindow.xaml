<Window x:Class="Giniyatullina_TRPO_6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Giniyatullina_TRPO_6"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="900"
        Background="{DynamicResource WindowBackground}">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right"
                    Content="Сменить тему"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="SmenitTheme_Click"/>
            <TextBlock Text="Управление умным домом"
                       FontSize="22" FontWeight="Bold"/>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Название сценария:"/>
            <TextBox Width="400" HorizontalAlignment="Left"
                     x:Name="ScenarioNameBox"/>

            <TextBlock Text="Описание сценария:"/>
            <TextBox Width="400" Height="70"
                     HorizontalAlignment="Left"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,10,0"
                    BorderBrush="{DynamicResource TextColor}"
                    BorderThickness="1"
                    Padding="5">
                <StackPanel>
                    <TextBlock Text="Устройства" Foreground="{DynamicResource TextColor}"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>
                    <CheckBox Content="Свет в гостиной" IsChecked="True"/>
                    <CheckBox Content="Кондиционер"/>
                    <CheckBox Content="Умная розетка" IsChecked="True"/>
                    <CheckBox Content="Камера во дворе"/>
                </StackPanel>
            </Border>

            
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource TextColor}" BorderThickness="1"
                    Padding="5">
                <StackPanel>
                    <TextBlock Text="Режим работы"
                               Foreground="{DynamicResource TextColor}"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <RadioButton Content="День"
                                 IsChecked="True"
                                 Foreground="{DynamicResource TextColor}"/>
                    <RadioButton Content="Ночь" Foreground="{DynamicResource TextColor}"/>
                    <RadioButton Content="Отпуск" Foreground="{DynamicResource TextColor}"/>

                    <TextBlock Text="Категория сценария:" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextColor}"/>
                    <ComboBox SelectedIndex="0" Foreground="{DynamicResource TextColor}">
                        <ComboBoxItem Content="Освещение"/>
                        <ComboBoxItem Content="Климат"/>
                        <ComboBoxItem Content="Безопасность"/>
                    </ComboBox>

                    <TextBlock Text="Загрузка системы:" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextColor}"/>
                    <ProgressBar Value="65" Maximum="100"/>
                </StackPanel>
            </Border>
        </Grid>

        
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Применить"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Сохранить как шаблон"
                    Style="{StaticResource SuccessButtonStyle}"/>
            <Button Content="Удалить устройство"
                    Style="{StaticResource DangerButtonStyle}"/>
            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Недоступно" IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
