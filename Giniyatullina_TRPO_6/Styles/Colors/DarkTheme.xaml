<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#111827"/>
    <SolidColorBrush x:Key="TextColor"         Color="#F9FAFB"/>
    <SolidColorBrush x:Key="PrimaryBackground"  Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimaryHover"       Color="#60A5FA"/>
    <SolidColorBrush x:Key="PrimaryPressed"     Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryForeground"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryBackground" Color="#374151"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="SecondaryHover"      Color="#4B5563"/>
    <SolidColorBrush x:Key="DangerBackground"  Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerHover"       Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerForeground"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ActiveBackground"  Color="#22C55E"/>
    <SolidColorBrush x:Key="InactiveBackground" Color="#6B7280"/>
</ResourceDictionary>